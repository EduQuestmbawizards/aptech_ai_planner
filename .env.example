# ==========================================
# APTECH AI CAREER & STUDY PLANNER ENV CONFIG
# ==========================================

# Database & Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Security & Authentication
JWT_SECRET_KEY=your-super-secret-jwt-signing-key-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
INVITATION_TOKEN_EXPIRE_HOURS=72

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# SMTP & Transactional Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=notifications@aptech-planner.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Aptech AI Planner <notifications@aptech-planner.com>
EMAIL_ENABLED=false

# URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# EduQuest Server-to-Server Integration
EDUQUEST_INTEGRATION_SECRET=eduquest-webhook-hmac-shared-secret-key

